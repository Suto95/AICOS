# Production environment template for AICOS migration stack
# Copy values into your secure production secret manager.

# Runtime
COSAI_ENV=production

# Session security (REQUIRED in production)
# Use a strong random secret (32+ chars)
COSAI_SESSION_SECRET=replace_with_strong_random_secret

# Data
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OAuth and auth callbacks
# Include only trusted production/staging callback URLs for your release
COSAI_REDIRECT_URI=https://your-frontend-domain.com/
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret

# API/Frontend integration
COSAI_API_CORS_ORIGINS=https://your-frontend-domain.com
VITE_API_BASE_URL=https://your-api-domain.com

# Optional observability
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
